<% layout("/layouts/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <br><br>
                <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
        <input name="listing[title]" placeholder="Add a Catchy Title" type="text" class="form-control" required>
        <div class="valid-feedback">Title Looks Good!</div>
        <div class="invalid-feedback">Please Enter the Title</div>
        </div>

        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
            <textarea name="listing[description]" class="form-control" placeholder="Enter Description" required></textarea>
            <div class="invalid-feedback">
                Please Enter the description
            </div>
        </div>

        <div class="mb-3">
            <lable for="image" class="form-label">Upload Image</lable>
            <input name="listing[image]" class="form-control" type="file" required>
        </div>


<div class="category-chips mb-3">
    <label >Choose Category</label>
    <br>

  <input type="checkbox" id="cat-iconic-cities" name="listing[category]" value="Iconic Cities" class="btn-check" hidden>
  <label for="cat-iconic-cities" class="chip-label">
    <i class="fa-solid fa-mountain-city"></i>
    <span>Iconic Cities</span>
  </label>

  <input type="checkbox" id="cat-mountains" name="listing[category]" value="Mountains" class="btn-check" hidden>
  <label for="cat-mountains" class="chip-label">
    <i class="fa-solid fa-mountain"></i>
    <span>Mountains</span>
  </label>

  <input type="checkbox" id="cat-castles" name="listing[category]" value="Castles" class="btn-check" hidden>
  <label for="cat-castles" class="chip-label">
    <i class="fa-brands fa-fort-awesome"></i>
    <span>Castles</span>
  </label>

  <input type="checkbox" id="cat-pools" name="listing[category]" value="Amazing Pools" class="btn-check" hidden>
  <label for="cat-pools" class="chip-label">
    <i class="fa-solid fa-person-swimming"></i>
    <span>Amazing Pools</span>
  </label>

  <input type="checkbox" id="cat-camping" name="listing[category]" value="Camping" class="btn-check" hidden>
  <label for="cat-camping" class="chip-label">
    <i class="fa-solid fa-campground"></i>
    <span>Camping</span>
  </label>

  <input type="checkbox" id="cat-farms" name="listing[category]" value="Farms" class="btn-check" hidden>
  <label for="cat-farms" class="chip-label">
    <i class="fa-solid fa-cow"></i>
    <span>Farms</span>
  </label>

  <input type="checkbox" id="cat-arctic" name="listing[category]" value="Arctic" class="btn-check" hidden>
  <label for="cat-arctic" class="chip-label">
    <i class="fa-regular fa-snowflake"></i>
    <span>Arctic</span>
  </label>

  <input type="checkbox" id="cat-domes" name="listing[category]" value="Domes" class="btn-check" hidden>
  <label for="cat-domes" class="chip-label">
    <i class="fa-solid fa-igloo"></i>
    <span>Domes</span>
  </label>

  <input type="checkbox" id="cat-boats" name="listing[category]" value="Boats" class="btn-check" hidden>
  <label for="cat-boats" class="chip-label">
    <i class="fa-solid fa-ship"></i>
    <span>Boats</span>
  </label>
</div>
        
        <div class="row">
            <div class="mb-3 col-md-4">
            <lable for="price" class="form-label">Price</lable>
            <input name="listing[price]" placeholder="1200" class="form-control" required>
            <div class="invalid-feedback">Please Enter the price</div>
            
        </div>
        
        <div class="mb-3 col-md-8">
            <lable for="country" class="form-label">Country</lable>
            <input name="listing[country]" class="form-control" placeholder="India" type="text" required>
            <div class="invalid-feedback">Please Enter the country name</div>
        </div>
        </div>
        
        
        <div class="mb-3">
            <lable for="location" class="form-label">Location</lable>
            <input name="listing[location]" class="form-control" placeholder="Jaipur,Rajasthan" type="text" required>
            <div class="invalid-feedback">Please Enter the location</div>
        </div>
        <button class="btn btn-dark add-btn mt-3">Add</button>
        
    </form>
    </div>
</div>
