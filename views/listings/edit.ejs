<% layout("/layouts/boilerplate") -%>
<div class="row mt-3">
<div class="col-8 offset-2">

    <h3>Edit your Listing</h3>
    <form method="POST" action="/listings/<%=listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="title" class="form-label">Title</lable>
            <input name="listing[title]" value="<%=listing.title %>" class="form-control" placeholder="enter title" type="text" required>
            <div class="valid-feedback">Title Looks Good!</div>
        <div class="invalid-feedback">Please Enter the Title</div>
        </div>
        <br><br>
        <div class="mb-3">
            <lable for="description" class="form-label">Description</lable>
                    <textarea class="form-control" name="listing[description]" required><%=listing.description %></textarea>
        
        <div class="invalid-feedback">
                Please Enter the description
            </div>
                </div>

        <br><br>

        <div class="mb-3">
            Original Listing Image <br>
            <img src="<%= orgImgUrl %>">

        </div>

        <div class="mb-3">
            <lable for="image" class="form-label">Image Link</lable>
            <input name="listing[image]" type="file" class="form-control">
        </div>
        
        <br><br>
        <div class="row">
            <div class="mb-3 col-md-4">
            <lable for="price" class="form-label">Price</lable>
            <input name="listing[price]" class="form-control" value="<%=listing.price %>" placeholder="enter price" type="number" required>
        <div class="invalid-feedback">Please Enter the price</div>
        </div>
        
        <br><br>
        <div class="mb-3 col-md-8">
            <lable for="country" class="form-label">Country</lable>
            <input name="listing[country]" class="form-control" value="<%=listing.country %>" placeholder="enter country" type="text" required>
        <div class="invalid-feedback">Please Enter the country name</div>
        </div>
        
        </div>
        
        
        <br><br>
        <div class="mb-3">
            <lable for="location" class="form-label">Location</lable>
            <input name="listing[location]" class="form-control" value="<%=listing.location %>" placeholder="enter location" type="text" required>
         <div class="invalid-feedback">Please Enter the location</div>
        </div>
        
        
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
    </div>
</div>
<script src="/js/script.js"></script>
