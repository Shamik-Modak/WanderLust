<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on WanderLust</h1>
        <div class="col-6 offset-3">
            <form action="/signup" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
            <lable for="username" class="form-label">Username</lable>
        <input name="username" id="username" placeholder="Enter username" type="text" class="form-control" required>
        <div class="valid-feedback">Looks Good!</div>
        <div class="invalid-feedback">Please Enter the Username</div>
        </div>

        <div class="mb-3">
            <lable for="email" class="form-label">Email</lable>
        <input name="email" id="email" placeholder="Enter email" type="text" class="form-control" required>
        </div>

        <div class="mb-3">
            <lable for="password" class="form-label">Password</lable>
        <input name="password" id="password" placeholder="Enter password" type="text" class="form-control" required>
        
        </div>
        <button class="btn btn-success">Sign Up</button>
            </form>
        </div>
</div>